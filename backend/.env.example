PORT=5000
MONGO_URI=
# Long random string used to sign login tokens: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Recipe photo uploads (free key from api.imgbb.com)
IMGBB_API_KEY=
# Optional AI features (free key from aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Optional: override DNS if mongodb+srv lookups fail on your network
#DNS_SERVERS=8.8.8.8,1.1.1.1
# Optional: use a different database name than the one in MONGO_URI (e.g. FamFest_test)
#MONGO_DB_NAME=
